# Local development defaults. Copy this file to .env before starting services.
APP_ENV=development
LOG_LEVEL=INFO

# Host-run settings: use these when the API runs directly on the host machine.
DATABASE_URL=postgresql+asyncpg://rag_eval:change-me@localhost:5432/rag_eval
REDIS_URL=redis://localhost:6379/0

# Compose-run settings: when the API runs in Docker, pass these values to the
# container instead; Compose service names resolve on the internal network.
COMPOSE_DATABASE_URL=postgresql+asyncpg://rag_eval:change-me@postgres:5432/rag_eval
COMPOSE_REDIS_URL=redis://redis:6379/0

CORS_ORIGINS=http://localhost:3000

POSTGRES_DB=rag_eval
POSTGRES_USER=rag_eval
POSTGRES_PASSWORD=change-me

# Replace local placeholders with generated values when the services require them.
SECRET_KEY=replace-with-a-generated-secret
