# Local development defaults. Copy this file to .env before starting services.
APP_ENV=development
LOG_LEVEL=INFO

# Host-run settings: use these when the API runs directly on the host machine.
DATABASE_URL=postgresql+asyncpg://rag_eval:change-me@localhost:5432/rag_eval
REDIS_URL=redis://localhost:6379/0

# Compose-run settings: when the API runs in Docker, Compose must map these
# values into the container's DATABASE_URL and REDIS_URL; service names resolve
# on the internal network, so do not use localhost for container connections.
COMPOSE_DATABASE_URL=postgresql+asyncpg://rag_eval:change-me@postgres:5432/rag_eval
COMPOSE_REDIS_URL=redis://redis:6379/0

CORS_ORIGINS=http://localhost:3003

# Web project context API base URL. The web app defaults to this value when
# NEXT_PUBLIC_API_BASE_URL is not set.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8003

POSTGRES_DB=rag_eval
POSTGRES_USER=rag_eval
POSTGRES_PASSWORD=change-me

# Before starting the API in any non-development environment, replace this
# local placeholder with a generated secret.
SECRET_KEY=replace-with-a-generated-secret

# Document ingestion foundations. Blob root must remain private and absolute.
BLOB_ROOT=/var/lib/rag-eval/blobs
MAX_UPLOAD_BYTES=52428800
# Hard cap for the complete HTTP request, including multipart framing/fields.
MAX_REQUEST_BODY_BYTES=53477376
MAX_PARSE_PAGES=10000
MAX_NORMALIZED_CHARACTERS=200000
MAX_PARSE_PARAGRAPHS=100000
MAX_CHUNK_CHARACTERS=2000
MAX_PDF_OBJECTS=100000
MAX_PDF_DECODED_STREAM_BYTES=104857600
MAX_PDF_RECURSION_DEPTH=100
MAX_PDF_RECURSION_OBJECTS=100000
MAX_PARSER_WALL_CLOCK_SECONDS=10
MAX_PARSER_OUTPUT_BYTES=67108864
MAX_DOCX_ZIP_ENTRIES=10000
MAX_DOCX_UNCOMPRESSED_BYTES=104857600
MAX_DOCX_COMPRESSION_RATIO=100
MAX_DOCX_XML_DEPTH=100
PARSER_REQUIRE_RESOURCE_LIMITS=false
# Required in production or strict parser mode. The command must enforce an
# Filesystem-isolated bwrap profile with network, identity, and resource limits.
PARSER_SANDBOX_EXECUTABLE=
PARSER_SANDBOX_ARGS=[]
WORKER_BATCH_SIZE=10
WORKER_LEASE_TTL_SECONDS=60
WORKER_POLL_INTERVAL_SECONDS=5
WORKER_HEARTBEAT_INTERVAL_SECONDS=20
WORKER_READINESS_FILE=/tmp/rag-eval-worker-ready
ORPHAN_BLOB_GRACE_SECONDS=3600
WORKER_REDIS_HINT_CHANNEL=rag-eval:worker:hints
WORKER_ENABLED=true

# Candidate generation is opt-in. Leave these empty until a provider adapter
# is intentionally configured with an exact host and port allowlist.
# If no Provider is configured, candidate generation returns provider_not_configured;
# the system never fabricates candidate data or silently uses a test Provider.
PROVIDER_BASE_URL=
PROVIDER_API_KEY=
PROVIDER_TIMEOUT_SECONDS=30
PROVIDER_ALLOWED_HOSTS=
PROVIDER_ALLOWED_PORTS=
